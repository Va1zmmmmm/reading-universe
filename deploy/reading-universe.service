[Unit]
Description=Reading Universe temporary analysis service
After=network-online.target
[Service]
Type=simple
User=reading-universe
Group=reading-universe
WorkingDirectory=/opt/reading-universe
Environment=READING_ORIGINS=https://YOUR_DOMAIN
ExecStart=/usr/bin/python3 /opt/reading-universe/server.py --host 127.0.0.1 --port 8766
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
TasksMax=128
[Install]
WantedBy=multi-user.target
